# Stage 1: Build the React Application (No change here)
FROM node:12-alpine as build
# ... (rest of Stage 1 remains the same: WORKDIR, COPY, RUN npm install, RUN npm run build)
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve the Built Application with Nginx
FROM nginx:alpine

# 1. Copy the custom Nginx configuration file
# This overwrites the default Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 2. Copy the built React files
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]